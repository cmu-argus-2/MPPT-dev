	(text "As specified in the datasheet we replace the thermistor\nwith a resistor of the same resistance as the bias \nresistor to simulate a constant 25C"
		(exclude_from_sim no)
		(at 203.2 115.316 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "020c50f7-219c-453c-b876-2ac83211d8f8")
	)
	(text "32mV acorss resistor cuts off current.\nResistor is 82mOhm\nTrip Current = 32m / 82m = 390mA < 500mA Fuse\nPower Drop Across Resistor = (500m)^2 * (82m) = 21mW"
		(exclude_from_sim no)
		(at 115.316 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "127fc278-dd3c-4fc4-8ed5-f1fafac04166")
	)
	(text "Same calculation as CLP-CLN Resistor"
		(exclude_from_sim no)
		(at 198.882 99.822 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4f8b0047-202d-4e8b-ac32-29b5728ac5d3")
	)
	(text "Max V_in = 4.15 * 5 = 20.75V\nFrequency = 1.5MHz (from RT resistor)\n(From datasheet):\nL = .3 * (Max V_in) / Frequency = 4.15uH"
		(exclude_from_sim no)
		(at 199.136 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6dd13997-8b3c-47bb-a445-73f1f48d5a9a")
	)
	(text "2 Cells therefore by table 5 of datasheet:\nCELLS0: VCC2P5\nCELLS1: INTVCC"
		(exclude_from_sim no)
		(at 62.484 85.598 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d5d886ee-41d8-4c4a-b024-60ec7bcbfb44")
	)
